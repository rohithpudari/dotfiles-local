# Cache brew prefix to avoid repeated subprocess calls
if [[ -z "$BREW_PREFIX" ]]; then
    export BREW_PREFIX="/opt/homebrew"
    # Only eval shellenv if not already done
    if [[ ":$PATH:" != *":$BREW_PREFIX/bin:"* ]]; then
        eval "$($BREW_PREFIX/bin/brew shellenv)"
    fi
fi

# Consolidated PATH setup using zsh arrays - much more efficient
typeset -U path  # Ensures no duplicates
path=(
    "$HOME/bin"
    "$BREW_PREFIX/opt/coreutils/libexec/gnubin"
    "$BREW_PREFIX/opt/make/libexec/gnubin"
    "$BREW_PREFIX/bin"
    $path
)
