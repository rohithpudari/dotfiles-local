	email = 27728974+rohithpudari@users.noreply.github.com

[github]
	user = rohithpudari

[log]
	date = auto:human

[core]
	pager = bat --style=numbers,changes --paging=always
    editor = nvim

# theme for git-delta
[include]
	path = ~/.git/catppuccin.gitconfig

[delta]
    features = catppuccin-mocha
    navigate = true
    side-by-side = true
    dark = true

[interactive]
    diffFilter = delta --color-only

[pager]
    diff = delta
    show = delta
    log = delta
    reflog = delta

[diff "scpt"]
	textconv = osadecompile
	binary=true
