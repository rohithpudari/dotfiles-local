" This wipes all existing settings. This means that if a setting in this file
" is removed, then it will return to default. In other words, this file serves
" as an enforced single point of truth for Tridactyl's configuration.
sanitize tridactyllocal tridactylsync

" Use dark theme
colorscheme dark

" Just use a blank page for new tab. It would be nicer to use the standard
" Firefox homepage, but Tridactyl doesn't support this yet.
set newtab about:blank

" K and J should move between tabs. x should close them.
bind J tabnext 
bind K tabprev
bind x tabclose

bind S saveas

" Ctrl-F should use the browser's native 'find' functionality.
unbind <C-f>

" But also support Tridactyl search too.
bind / fillcmdline find
bind ? fillcmdline find -?
bind n findnext 1
bind N findnext -1

" Yank current tab URL as markdown link format
bind ym composite url | jsb -p "[" + document.title + "](" + tri.contentLocation.href + ")" | yank

" Comment toggler for Reddit, Hacker News and Lobste.rs
bind ;c hint -Jc [class*="expand"],[class="togg"],[class="comment_folder"]

" Only hint search results on search engines
bindurl ^https://duckduckgo.com f hint -Jc article h2 a
bindurl ^https://duckduckgo.com F hint -Jbc article h2 a

set searchengine duckduckgo
set searchurls.amo https://addons.mozilla.org/en-US/firefox/search/?q=
set searchurls.archive https://web.archive.org/web/*/%s
set searchurls.g https://www.google.com/search?q=
set searchurls.map https://www.google.com/maps/search/%s
set searchurls.y https://www.youtube.com/results?search_query=

" common websites 
bind 'y tabopen https://youtube.com/
bind 'h tabopen https://news.ycombinator.com/news
bind '. tabopen about:config
bind 'g tabopen https://www.github.com/

" Disable only f key binding on YouTube to preserve fullscreen shortcut
unbindurl ^https://(www\.)?youtube\.com f

" Git{Hub,Lab} git clone via SSH yank
bind yg composite js document.location.href.replace(/$/,".git") | clipboard yank
" bind yg composite js "git clone " + document.location.href.replace(/https?:\/\//,"git@").replace("/",":").replace(/$/,".git") | clipboard yank

" Put Monkeytype in ignore mode to prevent interference with typing tests
autocmd DocStart ^https://(www\.)?monkeytype\.com mode ignore

" Put Overleaf in ignore mode to prevent interference with overleaf vim editor
autocmd DocStart ^https://(www\.)?overleaf\.com/project/.* mode ignore
