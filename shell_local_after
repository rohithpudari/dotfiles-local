# autojump config
[[ -s /fs1/eecg/shuruizgrp/rpudari/.autojump/etc/profile.d/autojump.sh ]] && source /fs1/eecg/shuruizgrp/rpudari/.autojump/etc/profile.d/autojump.sh

# PATH
path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin"

# Go
path_prepend "/usr/local/go/bin"
export GOPATH="$HOME/go"
path_prepend "$GOPATH/bin"

# Add scripts to path

path_prepend "$HOME/.dotfiles_local/bin"

# Update local dotfiles
ldfu() {
    declare -f dfu > /dev/null && dfu &&
    (
        cd ~/.dotfiles_local && git pull --ff-only && ./install -q
    )
}

# pyenv path
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# make backspace work in tmux
stty erase "^?"

# java paths
alias java17='/usr/lib/jvm/jdk-17-oracle-x64/bin/java '
alias java8='/usr/lib/jvm/jdk1.8.0_421/bin/java '
alias javac8='javac -source 1.8 -target 1.8 '
