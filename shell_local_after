# Sandboxed agents
nono-sandbox() {
    local profile=$1
    shift
    local default_cmd=() nono_args=() cmd_args=()
    local seg=default
    for arg in "$@"; do
        if [[ "$arg" == "--" ]]; then
            [[ $seg == default ]] && seg=nono || seg=cmd
        elif [[ $seg == default ]]; then
            default_cmd+=("$arg")
        elif [[ $seg == nono ]]; then
            nono_args+=("$arg")
        else
            cmd_args+=("$arg")
        fi
    done
    nono run --profile "$profile" --allow-cwd "${nono_args[@]}" -- "${default_cmd[@]}" "${cmd_args[@]}"
}

sandbox-opencode() {
    nono-sandbox my-opencode opencode -- "$@"
}

sandbox-guard() {
    echo "use \`sandbox-$1\` instead, or \`command $1\` for un-sandboxed $1" >&2; false
}
opencode() { sandbox-guard opencode; }

