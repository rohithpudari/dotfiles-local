# Add scripts to path

# path_prepend "$HOME/.dotfiles_local/bin"
typeset -U path  # Ensures no duplicates
path=(
    "$HOME/bin"
    "$HOME/.dotfiles_local/bin"
    $path
)

# Update local dotfiles
ldfu() {
  declare -f dfu > /dev/null && dfu &&(
      cd ~/.dotfiles_local && git pull --ff-only && ./install -q
  )
}

#gpg related
alias gpgst='gpg -k --list-options show-uid-validity'
alias gpgsgn='gpg --ask-cert-level --edit-key'
alias dirs='dirs -v'

# Push and jump
pj() {
  pushd "$(zoxide query "$@")"
}

# zoxide for autojump
# eval "$(zoxide init zsh)

# Lazy load zoxide with proper error handling
_init_zoxide() {
    if command -v zoxide >/dev/null 2>&1; then
        # Initialize zoxide and handle any errors
        if eval "$(zoxide init zsh)" 2>/dev/null; then
        else
            echo "Warning: zoxide initialization failed"
            return 1
        fi
        
        # Remove this function after successful initialization
        unfunction _init_zoxide
    else
        echo "zoxide not found in PATH"
        return 1
    fi
}

# Load zoxide on first directory change or when z command is used
autoload -U add-zsh-hook
add-zsh-hook chpwd _init_zoxide

# Create wrapper functions for immediate availability
z() {
    _init_zoxide
    z "$@"
}

# pyenv path
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# make backspace work in tmux
stty sane
stty erase "^?"


